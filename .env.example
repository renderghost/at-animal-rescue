# Settings for running Homeward on your own computer (docs/LOCAL.md). Copy this file:
#
#   cp .env.example .env
#
# It works as it is. The one setting worth adding is ADMIN_DIDS, to try /admin.
#
# Both ways of running Homeward read it: Docker (`docker compose up`) and `pnpm dev`. Docker
# uses its own addresses for the database and email, so one file does for both. After a
# change, run `docker compose up --wait` again, or restart `pnpm dev`.
#
# Never commit .env. Production has its own template: deploy/production.env.example.

# --- Database and email -------------------------------------------------------------------
# Matches docker-compose.yml.
DATABASE_URL=postgres://homeward:homeward@localhost:5432/homeward
# Mailpit catches every email Homeward sends: read them at http://localhost:8025.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Homeward <no-reply@homeward.localhost>

# --- Ports ---------------------------------------------------------------------------------
# Only if 3000 or 5432 is already taken on your computer (for example by another Postgres).
# If you change POSTGRES_PORT, change the port in DATABASE_URL above to match.
# WEB_PORT=3000
# POSTGRES_PORT=5432

# --- Moderators (#43) -----------------------------------------------------------------------
# DIDs of the accounts that may use /admin, separated by commas. Find an account's DID at
# https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=<handle>
ADMIN_DIDS=

# --- Encryption of private data -------------------------------------------------------------
# Keys for the private store and sessions (AES-256-GCM), as id:base64 pairs.
# Development only: this key is public. Never use it in production.
PRIVATE_STORE_KEYS=dev1:ZGV2LW9ubHktZG8tbm90LXVzZS1pbi1wcm9kdWN0aW8=
PRIVATE_STORE_ACTIVE_KEY=dev1

# --- Geocoding -----------------------------------------------------------------------------
# Town -> rough coordinates, through OpenStreetMap Nominatim, from the server only. Its usage
# policy asks for a contact address.
NOMINATIM_CONTACT=dev@localhost
# Optional: a self-hosted Nominatim instead of the public one.
NOMINATIM_URL=

# --- Welfare (#45) --------------------------------------------------------------------------
# The minimum age for listing puppies and kittens, in weeks.
WELFARE_MIN_AGE_WEEKS=8

# --- Indexer: checked facts for organisation pages (#29). All optional. --------------------
# Handles under these hosting providers get no domain fact (comma-separated).
HANDLE_PROVIDER_SUFFIXES=bsky.social,eurosky.social
# Bluesky AppView used to read verifications by trusted verifiers.
BSKY_APPVIEW_URL=
# DIDs of extra verifiers to trust beyond Bluesky's list, e.g. an EU body (comma-separated).
EXTRA_VERIFIERS=

# --- Public photos (#26) --------------------------------------------------------------------
# Resized copies are cached on disk and can always be rebuilt from the PDS.
# Defaults: apps/web/.cache/images (a volume in Docker) and 2048 MB.
IMAGE_CACHE_DIR=
IMAGE_CACHE_MAX_MB=

# --- Site address --------------------------------------------------------------------------
# Used for links in emails and shared previews. Empty: the address each request came in on
# with `pnpm dev`, and http://localhost:3000 in Docker.
SITE_URL=

# --- Off unless set -------------------------------------------------------------------------
# Cookie-free page views with self-hosted Umami (#46): its script URL and website ID.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
# Sign-in limits (#67) per client address, read from this header. Only behind our own
# reverse proxy (production: x-forwarded-for); anyone can send it otherwise.
CLIENT_IP_HEADER=
# Error reports (#48) to Bugsink, or any Sentry-compatible server.
SENTRY_DSN=
# The indexer's /health address, for /api/health. Docker sets it for you.
INDEXER_HEALTH_URL=
