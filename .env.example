# Copy to .env and adjust. Never commit .env.

# Postgres connection used by the web app, indexer and migrations.
# Matches the docker-compose.yml defaults.
DATABASE_URL=postgres://homeward:homeward@localhost:5432/homeward

# Outgoing email. In development, Mailpit catches everything at http://localhost:8025.
SMTP_URL=smtp://localhost:1025

# Encryption keys for the private store (AES-256-GCM), as id:base64 pairs.
# Generate a key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# To rotate: add a new key, make it active, run the rotation, then remove the old key.
# Development-only example key below. Never use it in production.
PRIVATE_STORE_KEYS=dev1:ZGV2LW9ubHktZG8tbm90LXVzZS1pbi1wcm9kdWN0aW8=
PRIVATE_STORE_ACTIVE_KEY=dev1

# Geocoding (town -> coarse coordinates) via OpenStreetMap Nominatim, server-side only.
# The usage policy requires a contact in the User-Agent: use a real email or URL.
NOMINATIM_CONTACT=dev@localhost
# Optional: point at a self-hosted Nominatim instance instead of the public one.
NOMINATIM_URL=
