# Production settings for Homeward (docs/DEPLOY.md, step 5).
#
#   1. Copy this file to the server as /opt/homeward/.env, and make it private:
#        chmod 600 /opt/homeward/.env
#   2. Fill in every setting marked [required]. The command to make each secret is beside it.
#   3. Check your work:
#        docker compose -f compose.production.yml run --rm check
#
# Every deploy runs the same check first, and stops before changing anything if a setting is
# wrong. Never commit the filled-in file, or paste it into chat, issues or email: keep a copy
# in the shared password manager. On your own computer, use .env.example instead.

# --- Server -------------------------------------------------------------------------------
# [required] Homeward's domain: a name only, no https://. Its DNS points at this server.
DOMAIN=homeward.example
# [required] https:// followed by DOMAIN.
SITE_URL=https://homeward.example
# [optional] Your contact address for Let's Encrypt, which issues the certificates.
ACME_EMAIL=ops@homeward.example
# Leave as it is: each deploy picks the version itself.
IMAGE_TAG=latest

# --- Database -----------------------------------------------------------------------------
# [required] Letters and digits only, as it goes into the database address:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
# [required] The key that encrypts private data and sessions, written as k1:<key>:
#   echo "k1:$(openssl rand -base64 32)"
# Keep a copy offline with the backup key: without it, private data can't be read, even
# from a backup. Rotating keys: see "Secrets" in docs/DEPLOY.md.
PRIVATE_STORE_KEYS=
# [required] The id of the key in use: k1, unless you've rotated keys.
PRIVATE_STORE_ACTIVE_KEY=k1

# --- App ----------------------------------------------------------------------------------
# [recommended] DIDs of the moderators who may use /admin (#43), separated by commas.
# Organisations need approving there before their listings are public. Find a DID at
# https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle?handle=<handle>
ADMIN_DIDS=
# [required] Email through Scaleway Transactional Email (#48): the project's ID and the
# secret key of an API key that may send email (docs/DEPLOY.md, step 1).
TEM_PROJECT_ID=
TEM_SECRET_KEY=
# [required] The sender, on the domain verified in Transactional Email.
EMAIL_FROM=Homeward <no-reply@homeward.example>
# [required] OpenStreetMap Nominatim, which turns towns into map positions, asks for a
# contact address.
NOMINATIM_CONTACT=ops@homeward.example
# Leave these as they are.
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
CLIENT_IP_HEADER=x-forwarded-for
IMAGE_CACHE_MAX_MB=2048
# The minimum age for listing puppies and kittens, in weeks (#45).
WELFARE_MIN_AGE_WEEKS=8

# --- Backups (docs/DEPLOY.md, steps 1 and 4) ----------------------------------------------
# [required] The age public keys (age1...) backups are encrypted to, separated by spaces.
# The private keys stay offline.
BACKUP_AGE_RECIPIENTS=
# The hour (UTC) of the nightly backup, and where it goes.
BACKUP_HOUR=3
BACKUP_REMOTE=backup:homeward-backups
# [required] The bucket's access key and secret key, from Scaleway IAM.
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# Scaleway Object Storage in Paris. Leave these as they are.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Scaleway
RCLONE_CONFIG_BACKUP_REGION=fr-par
RCLONE_CONFIG_BACKUP_ENDPOINT=s3.fr-par.scw.cloud
# [optional] The Uptime Kuma push URL for the backup heartbeat (step 9).
BACKUP_HEARTBEAT_URL=

# --- Errors (#48, docs/DEPLOY.md step 6) -------------------------------------------------
# [required] Bugsink's own address, with DNS pointing at this server like DOMAIN.
ERRORS_DOMAIN=errors.homeward.example
# [required] openssl rand -base64 50
BUGSINK_SECRET_KEY=
# [after first start] The DSNs Bugsink shows for its "web" and "indexer" projects.
SENTRY_DSN_WEB=
SENTRY_DSN_INDEXER=

# --- Analytics (optional, #46, docs/DEPLOY.md step 8) -------------------------------------
ANALYTICS_DOMAIN=
# openssl rand -base64 32
UMAMI_APP_SECRET=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
