# Production settings (#47). Copy to /opt/homeward/.env on the server and fill in; never
# commit the result. Compose reads this file for the containers and for ${...} in
# compose.production.yml.

# --- Server -------------------------------------------------------------------------------
# Homeward's address (DNS A/AAAA records point at the server) and the Let's Encrypt contact.
DOMAIN=homeward.example
ACME_EMAIL=ops@homeward.example
SITE_URL=https://homeward.example
# Set by the deploy workflow to the commit being deployed; "latest" otherwise.
IMAGE_TAG=latest

# --- Database -----------------------------------------------------------------------------
# A long random password: openssl rand -base64 32
POSTGRES_PASSWORD=
# Encryption keys for the private store and sessions (AES-256-GCM), as id:base64 pairs.
# Generate a key with `openssl rand -base64 32`, e.g. PRIVATE_STORE_KEYS=k1:<key> and
# PRIVATE_STORE_ACTIVE_KEY=k1. Keep a copy offline: without it, private data can't be read,
# even from backups.
PRIVATE_STORE_KEYS=
PRIVATE_STORE_ACTIVE_KEY=

# --- App ----------------------------------------------------------------------------------
# Moderators' DIDs (#43), comma-separated.
ADMIN_DIDS=
# Email (#48): an EU transactional provider, e.g. Scaleway TEM.
SMTP_URL=
EMAIL_FROM=Homeward <no-reply@homeward.example>
# OpenStreetMap Nominatim asks for a contact address.
NOMINATIM_CONTACT=ops@homeward.example
JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
IMAGE_CACHE_MAX_MB=2048
# Welfare (#45): the minimum age for listing puppies and kittens, in weeks.
WELFARE_MIN_AGE_WEEKS=8

# --- Backups ------------------------------------------------------------------------------
# age public keys (age1...) the dumps are encrypted to; the private keys stay offline.
BACKUP_AGE_RECIPIENTS=
BACKUP_HOUR=3
BACKUP_REMOTE=backup:homeward-backups
# Scaleway Object Storage (Paris), private bucket, through rclone's S3 support.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Scaleway
RCLONE_CONFIG_BACKUP_REGION=fr-par
RCLONE_CONFIG_BACKUP_ENDPOINT=s3.fr-par.scw.cloud
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
# Optional: a URL an uptime monitor expects to be called after each backup (#48).
BACKUP_HEARTBEAT_URL=

# --- Analytics (optional, #46) -------------------------------------------------------------
ANALYTICS_DOMAIN=
UMAMI_APP_SECRET=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
