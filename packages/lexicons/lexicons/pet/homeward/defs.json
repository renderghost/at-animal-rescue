{
  "lexicon": 1,
  "id": "pet.homeward.defs",
  "description": "Shared definitions for Homeward records.",
  "defs": {
    "place": {
      "type": "object",
      "description": "A publicly shown place, at town level. Coordinates are coarse (2 decimal places, about 1 km) and used only for distance search.",
      "required": ["country", "locality"],
      "properties": {
        "locality": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "Town or city."
        },
        "region": {
          "type": "string",
          "maxLength": 1000,
          "maxGraphemes": 100,
          "description": "County, province or state."
        },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "ISO 3166-1 alpha-2 country code, e.g. GB, NL."
        },
        "latitude": {
          "type": "string",
          "maxLength": 12,
          "description": "Decimal degrees as a string, rounded to 2 decimal places."
        },
        "longitude": {
          "type": "string",
          "maxLength": 12,
          "description": "Decimal degrees as a string, rounded to 2 decimal places."
        }
      }
    },
    "area": {
      "type": "object",
      "description": "A coarse area (country and optional region). Never contains a street address or coordinates.",
      "required": ["country"],
      "properties": {
        "region": { "type": "string", "maxLength": 1000, "maxGraphemes": 100 },
        "country": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2,
          "description": "ISO 3166-1 alpha-2 country code."
        }
      }
    },
    "species": {
      "type": "string",
      "maxLength": 64,
      "knownValues": [
        "dog",
        "cat",
        "rabbit",
        "guineaPig",
        "hamster",
        "gerbil",
        "rat",
        "mouse",
        "chinchilla",
        "degu",
        "ferret",
        "other"
      ]
    },
    "size": {
      "type": "string",
      "maxLength": 32,
      "knownValues": ["small", "medium", "large", "extraLarge"]
    },
    "ageGroup": {
      "type": "string",
      "maxLength": 32,
      "knownValues": ["young", "adult", "senior"]
    },
    "image": {
      "type": "object",
      "required": ["image", "alt"],
      "properties": {
        "image": {
          "type": "blob",
          "accept": ["image/jpeg", "image/png", "image/webp"],
          "maxSize": 2000000
        },
        "alt": {
          "type": "string",
          "maxLength": 10000,
          "maxGraphemes": 1000,
          "description": "Alt text describing the image. Required."
        },
        "aspectRatio": { "type": "ref", "ref": "#aspectRatio" }
      }
    },
    "aspectRatio": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": {
          "type": "integer",
          "minimum": 0,
          "description": "Amount in minor units (e.g. pence, cents)."
        },
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "description": "ISO 4217 currency code, e.g. GBP, EUR."
        }
      }
    }
  }
}
